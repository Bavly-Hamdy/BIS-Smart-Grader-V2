rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Faculty collection: Only authenticated users can read/write their own document
    match /faculty/{facultyId} {
      allow read: if isAuthenticated();
      
      // Faculty members can create their own profile during registration (allowing .edu.eg generally)
      allow create: if isOwner(facultyId) && 
                       request.resource.data.email.matches('.*@.*\\.edu\\.eg$');
      
      // Faculty members can update their own profile
      allow update: if isOwner(facultyId) &&
                       request.resource.data.email == resource.data.email;
      
      // Prevent deletion of faculty accounts
      allow delete: if false;
    }
    
    // Courses collection: Faculty can only access courses they created
    match /courses/{courseId} {
      allow read: if isAuthenticated() && 
                     resource.data.facultyId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.facultyId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
    }
    
    // Exams collection: Faculty can access exams of courses they own
    match /exams/{examId} {
      allow read: if isAuthenticated() && 
                     resource.data.facultyId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.facultyId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
    }

    // Submissions collection: Faculty can access submissions of their exams
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && 
                     resource.data.facultyId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.facultyId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       resource.data.facultyId == request.auth.uid;
    }
    
    // Students collection: Faculty can read student data
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // Grades collection
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      
      allow delete: if isAuthenticated(); // Allow deletion for admin features
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
